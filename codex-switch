#!/usr/bin/env bash
# codex-switch launcher (macOS / Linux / Git Bash)
#   macOS/Linux: requires PowerShell 7 (pwsh)  -> https://aka.ms/powershell
#   Windows (Git Bash, MSYS, Cygwin): uses pwsh if available, else powershell.exe
set -euo pipefail

dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
script="$dir/codex-switch.ps1"

if [ ! -f "$script" ]; then
    echo "codex-switch.ps1 not found next to this launcher ($dir)" >&2
    exit 1
fi

case "$(uname -s)" in
    Darwin|Linux)
        if ! command -v pwsh >/dev/null 2>&1; then
            echo "PowerShell 7 (pwsh) is required on macOS/Linux. Install it from https://aka.ms/powershell" >&2
            exit 1
        fi
        exec pwsh -NoProfile -File "$script" "$@"
        ;;
    *)
        # Windows (Git Bash / MSYS / Cygwin)
        if command -v pwsh >/dev/null 2>&1; then
            exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$script" "$@"
        elif command -v powershell.exe >/dev/null 2>&1; then
            exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$script" "$@"
        else
            echo "Neither 'pwsh' nor 'powershell.exe' was found on PATH." >&2
            exit 1
        fi
        ;;
esac
